    - target: {fileID: 1320460311782135910, guid: ddf1d33731ea2c941ab3af76b5060fb3, type: 3}
      propertyPath: m_text
      value: "Your Goal\n\n\r\nYour goal is to successfully complete your heist.\n\r\n\nTo
        do that, you need to steal the six Items listed on the Item Card and then
        escape the mansion through one of the exits.\n\r\n\nYou must use your Lantern
        to find an Item before you can collect it.\r"
      objectReference: {fileID: 0}
